{
  "name": "zudo-design-token-panel",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter doc dev",
    "demo:wind": "pnpm --filter demo-zudowind dev",
    "demo:cssmodules": "pnpm --filter demo-cssmodules dev",
    "build": "pnpm -r --if-present build",
    "deploy:wind": "pnpm --filter demo-zudowind build:deploy && pnpm --dir demos/zudowind exec wrangler deploy",
    "deploy:cssmodules": "pnpm --filter demo-cssmodules build:deploy && pnpm --dir demos/cssmodules exec wrangler deploy",
    "test": "pnpm -r --if-present test",
    "test:release": "node --test 'scripts/release/*.test.mjs' scripts/prune-stale-next-dist-tag.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "b4push": "bash scripts/run-b4push.sh",
    "check:deploy-paths": "bash scripts/check-deploy-paths.sh",
    "prepare": "lefthook install && bash scripts/install-git-hooks.sh",
    "init-worktree": "bash scripts/install-git-hooks.sh",
    "check:packed-types": "node scripts/check-packed-types.mjs",
    "check:dashboard-consumer": "node scripts/check-dashboard-consumer.mjs",
    "check:dashboard-client-consumer": "node scripts/check-dashboard-client-consumer.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Takazudo/zudo-design-token-panel.git"
  },
  "homepage": "https://github.com/Takazudo/zudo-design-token-panel",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "lefthook": "^2.1.6",
    "wrangler": "^4.149.0"
  }
}
