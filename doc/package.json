{
  "name": "doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "typecheck": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:asset-prefix": "bash ../scripts/check-deploy-paths.sh",
    "gen:z-index": "gen-z-index",
    "check:z-index": "gen-z-index --check",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "b4push": "bash scripts/run-b4push.sh",
    "gen:doc-history": "doc-history-generate --content-dir src/content/docs --locale ja:src/content/docs-ja --out-dir dist/doc-history"
  },
  "dependencies": {
    "@takazudo/zfb": "0.1.0-next.68",
    "@takazudo/zfb-runtime": "0.1.0-next.68",
    "@takazudo/zfb-adapter-cloudflare": "0.1.0-next.68",
    "@takazudo/zudo-doc": "^1.1.0",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "shiki": "^4.0.2",
    "@shikijs/transformers": "^4.0.0",
    "gray-matter": "^4.0.0",
    "mermaid": "^11.12.3",
    "remark-cjk-friendly": "^2.0.1",
    "remark-directive": "^3.0.0",
    "katex": "^0.16.38",
    "diff": "^8.0.3",
    "minisearch": "^7.2.0",
    "@takazudo/zudo-doc-history-server": "^1.1.0",
    "@takazudo/zdtp": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "html-validate": "^10.0.0",
    "pagefind": "^1.4.0"
  }
}
