{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "generate:build-info": "node ../scripts/generate-example-build-info.mjs --out config/build-info.generated.ts",
    "generate:build-info:deploy": "node ../scripts/generate-example-build-info.mjs --out config/build-info.generated.ts --deploy",
    "prepare:panel": "pnpm run generate:build-info && pnpm --filter @takazudo/zdtp build",
    "prepare:deploy": "pnpm run generate:build-info:deploy && pnpm --filter @takazudo/zdtp build",
    "predev": "pnpm run prepare:panel",
    "dev": "concurrently -k -n zfb,tokens-bin -c blue,green \"pnpm run dev:zfb\" \"pnpm run dev:tokens-bin\"",
    "predev:zfb": "pnpm run prepare:panel",
    "dev:zfb": "zfb dev --port 44327",
    "dev:tokens-bin": "node ../packages/zdtp/dist/bin/server.js --write-root . --routing scaffold.routing.json --port 24685 --allow-origin http://localhost:44327",
    "prebuild": "pnpm run prepare:panel",
    "build": "zfb build",
    "prebuild:deploy": "pnpm run prepare:deploy",
    "build:deploy": "zfb build",
    "preview": "zfb preview",
    "pretypecheck": "pnpm run prepare:panel",
    "typecheck": "zfb check"
  },
  "dependencies": {
    "@takazudo/zdtp": "workspace:*",
    "@takazudo/zfb": "2.13.1",
    "@takazudo/zfb-runtime": "2.13.1",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0"
  }
}
